# ==========================================
# Visual Studio / ASP.NET GitIgnore Template
# ==========================================

# Build output (important to ignore)
[Bb]in/
[Oo]bj/

# Visual Studio hidden folders
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# NuGet packages
*.nupkg
packages/
*.nuget.props
*.nuget.targets

# Log and cache files
*.log
[Ll]og/
[Ll]ogs/

# Mac OS 
.DS_Store

# Publish files
*.Publish.xml
*.pubxml
*.pubxml.user

# Local development settings (optional but recommended)
appsettings.Development.json

# ==========================================
# Extra Additions for Team Dev & ASP.NET Core
# ==========================================

# SQLite Databases (prevent overriding team data)
*.db
*.db-shm
*.db-wal
*.sqlite

# Other IDEs settings (VS Code, JetBrains Rider)
.vscode/
.idea/

# Front-End dependencies
node_modules/

# User uploaded files / Test files (Optional: uncomment and adjust path if you save files to disk)
# /wwwroot/uploads/
# /JustBigO_Fun_/SampleTestFiles/