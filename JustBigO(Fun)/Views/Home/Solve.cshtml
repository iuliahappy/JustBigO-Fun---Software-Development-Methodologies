@model JustBigO_Fun_.Models.Problem
@{
    ViewData["Title"] = "Solve: " + (Model?.Title ?? "Problem");
    var codeTemplatesJson = System.Text.Json.JsonSerializer.Serialize(Model?.GetCodeTemplates() ?? new Dictionary<string, string>());
}


    <div class="jbo-workspace-panel jbo-problem-panel">
        <div class="jbo-panel-header">
            <h1 class="jbo-problem-title">@(Model?.OrderIndex). @(Model?.Title)</h1>
            <div class="jbo-chip-row">
                <span class="jbo-chip jbo-chip--@(Model?.GetDifficultyClass())">@(Model?.Difficulty)</span>
                @foreach (var tag in Model?.GetTags() ?? Array.Empty<string>())
                {
                    <span class="jbo-chip">@tag</span>
                }
            </div>
        </div>

        <div class="jbo-problem-content">
            @Html.Raw(Model?.Description)
        </div>

        <div class="jbo-hint-section">
            <button class="btn jbo-btn-ghost w-100 d-flex justify-content-center align-items-center gap-2" id="askHintBtn">
                <span>💡 Ask for a Hint (AI Mentor)</span>
                <span class="badge bg-secondary">3 left</span>
            </button>
            <div id="hintContainer" class="jbo-hint-content"></div>
        </div>
    </div>

    <div class="jbo-workspace-right">

        <div class="jbo-editor-toolbar">
            <select class="jbo-language-select" id="languageSelect">
                <option value="python">Python</option>
                <option value="java">Java</option>
                <option value="cpp">C++</option>
            </select>

            <div class="jbo-complexity-badges">
                <span class="jbo-badge-soft" id="timeComplexity" title="Estimated time">⏱ O(?)</span>
                <span class="jbo-badge-soft" id="spaceComplexity" title="Estimated space">💾 O(?)</span>
            </div>
        </div>

    <div id="aiLoadingIndicator" class="alert alert-info py-2 mb-2 d-flex align-items-center" style="display: none !important; font-size: 0.9rem;">
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
        <strong>AI is transpiling the code...</strong>
    </div>

    <div id="monaco-editor-container" class="jbo-monaco-container" data-problem-id="@(Model?.Id)" style="min-height: 400px;"></div>

        <div class="jbo-console-panel">
            <div class="jbo-console-header">
                <span>Console Output</span>
                <div class="jbo-console-actions">
                    <a asp-controller="Home" asp-action="MySubmissions" asp-route-problemId="@Model?.Id" class="btn jbo-btn-ghost btn-sm text-decoration-none" target="_blank" title="View my submission history for this problem">
                        <i class="bi bi-clock-history"></i> My History
                    </a>
                    <button class="btn jbo-btn-primary btn-sm" id="btnSubmit">Submit</button>
                </div>
            </div>
            <div class="jbo-console-body" id="consoleOutput">
                Ready. Select a language and write your code.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js"></script>
    <script>
        const codeTemplates = @Html.Raw(codeTemplatesJson) || {};

        // Monaco Editor init
        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
        require(['vs/editor/editor.main'], function () {
        const defaultCode = '// Write your solution here';
        const initialLang = 'python';
        const initialCode = codeTemplates[initialLang] || codeTemplates['java'] || codeTemplates['cpp'] || Object.values(codeTemplates)[0] || defaultCode;

        window.editor = monaco.editor.create(document.getElementById('monaco-editor-container'), {
        value: initialCode,
        language: initialLang,
        theme: 'vs-dark',
        automaticLayout: true,
        minimap: { enabled: false },
        fontSize: 14,
        fontFamily: '"JetBrains Mono", Consolas, monospace',
        scrollBeyondLastLine: false,
        roundedSelection: true
        });

        // 0. Setup SignalR Connection to your Hub
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/translationHub")
            .build();

        // 1. Listen for the AI "typing" chunks of code (WITH MARKDOWN SCRUBBER)
        connection.on("ReceiveCodeChunk", function (chunk) {
            let currentCode = window.editor.getValue();
            let newCode = currentCode + chunk;

            // Scrub out any markdown blocks (```cpp, ```java, or just ```)
            // We run this on the whole string so it catches ticks even if they streamed in one by one
            newCode = newCode.replace(/```[a-zA-Z]*\n?/g, "").replace(/```/g, "");

            window.editor.setValue(newCode);
            window.editor.revealLine(window.editor.getModel().getLineCount());
        });

        connection.start().catch(err => console.error("SignalR Error: ", err));

        let currentLang = document.getElementById('languageSelect').value;

        // 2. Handle Language Change (WITH LOADING BAR)
        document.getElementById('languageSelect').addEventListener('change', async function(e) {
            const newLang = e.target.value;
            const sourceCode = window.editor.getValue();
            const loadingBar = document.getElementById('aiLoadingIndicator');

            // Show the loading bar
            loadingBar.style.setProperty('display', 'flex', 'important');

            monaco.editor.setModelLanguage(window.editor.getModel(), newLang);
            window.editor.setValue("");

            try {
                // The invoke method will 'await' until the C# method completely finishes streaming
                await connection.invoke("TranslateCode", sourceCode, currentLang, newLang);
            } catch (err) {
                console.error("Translation Error: ", err);
                window.editor.setValue("// Error translating code.");
            } finally {
                // Hide the loading bar once streaming is completely done (or if it fails)
                loadingBar.style.setProperty('display', 'none', 'important');
                currentLang = newLang;
            }
        });

        document.getElementById('btnSubmit').addEventListener('click', async function() {
        const sourceCode = window.editor.getValue();
        const language = document.getElementById('languageSelect').value;
        const problemId = document.getElementById('monaco-editor-container').dataset.problemId;
        const consoleOutput = document.getElementById('consoleOutput');
                
        consoleOutput.innerHTML = "Submitting...";
                
        try {
        const response = await fetch('/api/submission', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ problemId: parseInt(problemId), sourceCode, language })
        });
                    
        if (!response.ok) throw new Error(await response.text());
                    
        const data = await response.json();
        pollStatus(data.submissionId);
        } catch (err) {
        consoleOutput.innerHTML = "Error: " + err.message;
        }
        });

        async function pollStatus(id) {
        const consoleOutput = document.getElementById('consoleOutput');
        const interval = setInterval(async () => {
        try {
        const response = await fetch('/api/submission/' + id);
        const data = await response.json();
                        
        consoleOutput.innerHTML = "Status: " + data.status + "...";
                        
        if (data.status !== 'Pending' && data.status !== 'Running' && data.status !== 'Compiling') {
        clearInterval(interval);
        displayResult(data);
        }
        } catch (err) {
        clearInterval(interval);
        consoleOutput.innerHTML = "Error polling: " + err.message;
        }
        }, 2000);
        }

        function displayResult(data) {
        const consoleOutput = document.getElementById('consoleOutput');
        let html = `<div class="p-2">
        <h4 class="${data.status === 'Accepted' ? 'text-success' : 'text-danger'}">Submission: ${data.status}</h4>
        <hr class="my-2 border-secondary"/>`;

        if (data.results) {
        const results = JSON.parse(data.results);
        results.forEach((r, idx) => {
        const isOk = r.status === 'Accepted';
        html += `
        <div class="mb-4 p-2 border ${isOk ? 'border-success' : 'border-danger'} rounded bg-dark">
        <div class="d-flex justify-content-between">
        <strong>Test Case #${idx + 1}</strong>
        <span class="badge ${isOk ? 'bg-success' : 'bg-danger'}">${r.status}</span>
        </div>
        <div class="mt-2">
        <small class="text-muted">Input:</small>
        <pre class="m-0 p-1 bg-black text-info small">${r.input || 'N/A'}</pre>
        </div>
        <div class="mt-2">
        <small class="text-muted">Expected:</small>
        <pre class="m-0 p-1 bg-black text-success small">${r.expected || 'N/A'}</pre>
        </div>
        <div class="mt-2">
        <small class="text-muted">Actual Output (stdout):</small>
        <pre class="m-0 p-1 bg-black text-light small">${r.output || 'N/A'}</pre>
        </div>
        ${r.error ? `
        <div class="mt-2">
        <small class="text-muted">Error (stderr):</small>
        <pre class="m-0 p-1 bg-black text-danger small">${r.error}</pre>
        </div>` : ''}
        </div>`;
        });
        } else if (data.errorMessage) {
        html += `<div class="alert alert-danger">${data.errorMessage}</div>`;
        }
                
        html += `</div>`;
        consoleOutput.innerHTML = html;
        }
        });
    </script>
}