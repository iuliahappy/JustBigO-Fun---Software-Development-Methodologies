@model JustBigO_Fun_.Models.Problem
@{
    ViewData["Title"] = "Solve: " + (Model?.Title ?? "Problem");
    // This variable is required by the editor script:
    var codeTemplatesJson = System.Text.Json.JsonSerializer.Serialize(Model?.GetCodeTemplates() ?? new Dictionary<string, string>());
}

<div class="d-flex w-100 h-100">
    <div class="jbo-workspace-panel jbo-problem-panel">
        <div class="jbo-panel-header">
            <h1 class="jbo-problem-title">@(Model?.OrderIndex). @(Model?.Title)</h1>
            <div class="jbo-chip-row">
                <span class="jbo-chip jbo-chip--@(Model?.GetDifficultyClass())">@(Model?.Difficulty)</span>
                @foreach (var tag in Model?.GetTags() ?? Array.Empty<string>())
                {
                    <span class="jbo-chip">@tag</span>
                }
            </div>
        </div>

        <div class="jbo-problem-content">
            @Html.Raw(Model?.Description)
        </div>

        <div class="jbo-hint-section">
            <button class="btn jbo-btn-ghost w-100 d-flex justify-content-center align-items-center gap-2" id="askHintBtn">
                <span>💡 Ask for a Hint</span>
                <span class="badge bg-secondary">AI Mentor</span>
            </button>
            <div id="hintContainer" class="jbo-hint-content"></div>
        </div>

        <div class="jbo-hint-section">
            <button type="button" class="btn jbo-btn-ghost w-100 d-flex justify-content-center align-items-center gap-2" id="btnImproveSolution" disabled
                    title="Submit your code and wait until the judge reports Accepted on this page.">
                <span>Improve solution</span>
                <span class="badge bg-secondary">Mentor</span>
            </button>
            <p class="small text-muted mb-0 mt-1 px-1">Unlocked only after a successful <strong>Submit</strong> with status <strong>Accepted</strong> (Docker) on this page.</p>
            <div id="improveSolutionPanel" class="jbo-improve-panel d-none mt-2" aria-readonly="true">
                <div class="jbo-improve-readonly rounded p-2 small">
                    <div class="fw-semibold text-secondary mb-1">Code area to refactor</div>
                    <pre id="improveCodeBlock" class="jbo-improve-pre mb-3"></pre>
                    <div class="fw-semibold text-secondary mb-1">Optimal data structure / pattern</div>
                    <pre id="improveOptimalDs" class="jbo-improve-pre mb-3"></pre>
                    <div class="fw-semibold text-secondary mb-1">Refactoring steps (read-only)</div>
                    <pre id="improveSteps" class="jbo-improve-pre mb-0"></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="jbo-workspace-right w-100 d-flex flex-column">

        <div class="jbo-editor-toolbar d-flex align-items-center gap-2 p-2">
            <span class="small text-muted fw-bold ms-1">Source:</span>
            <select class="jbo-language-select form-select form-select-sm w-auto" id="languageSelect">
                <option value="python">Python</option>
                <option value="java">Java</option>
                <option value="cpp">C++</option>
            </select>

            <span class="small text-muted fw-bold ms-2">Target:</span>
            <select class="jbo-language-select form-select form-select-sm w-auto border-info" id="targetLanguageSelect">
                <option value="python">Python</option>
                <option value="java" selected>Java</option>
                <option value="cpp">C++</option>
            </select>

            <button id="btnTranspile" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1 ms-2">
                <i class="bi bi-robot"></i> Convert from Python to Java
            </button>

            <button type="button" class="btn jbo-btn-ghost btn-sm ms-2" id="btnCompleteCode" title="AI completes your partial solution on the same approach (separate from Submit)">
                ✨ Complete current code
            </button>

            <div class="jbo-complexity-badges ms-auto">
                <span class="jbo-badge-soft" id="timeComplexity" title="Estimated time">⏱ O(?)</span>
                <span class="jbo-badge-soft" id="spaceComplexity" title="Estimated space">💾 O(?)</span>
            </div>
        </div>

        <div id="aiLoadingIndicator" class="alert alert-info py-2 mb-2 mx-2 d-flex align-items-center" style="display: none !important; font-size: 0.9rem;">
            <div class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></div>
            <strong>AI is transpiling the code...</strong>
        </div>

        <!-- Side-by-Side Editor Layout -->
        <div class="d-flex gap-2 w-100 px-2" style="min-height: 400px; flex: 1;">
            <!-- User's Editor (Left) -->
            <div id="monaco-editor-container" class="jbo-monaco-container w-100" data-problem-id="@(Model?.Id)"></div>
            <!-- AI's Editor (Right) -->
            <div id="ai-editor-container" class="jbo-monaco-container w-50 border-start border-info" style="display: none;"></div>
        </div>

        <div class="jbo-console-panel mt-2">
            <div class="jbo-console-header">
                <span>Console Output</span>
                <div class="jbo-console-actions">
                    <a asp-controller="Home" asp-action="MySubmissions" asp-route-problemId="@Model?.Id" class="btn jbo-btn-ghost btn-sm text-decoration-none" target="_blank" title="View my submission history for this problem">
                        <i class="bi bi-clock-history"></i> My History
                    </a>
                    <button class="btn jbo-btn-primary btn-sm" id="btnSubmit">Submit</button>
                </div>
            </div>
            <div class="jbo-console-body" id="consoleOutput">
                Ready. Select a language and write your code.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/require.js/2.3.6/require.min.js"></script>
    <script>
        const codeTemplates = @Html.Raw(codeTemplatesJson) || {};

        function escapeHtml(str) {
            if (str == null || str === '') return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // Monaco Editor init
        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
        require(['vs/editor/editor.main'], function () {
            const defaultCode = '// Write your solution here';
            const initialLang = 'python';
            const initialCode = codeTemplates[initialLang] || codeTemplates['java'] || codeTemplates['cpp'] || Object.values(codeTemplates)[0] || defaultCode;

            // User Editor
            window.editor = monaco.editor.create(document.getElementById('monaco-editor-container'), {
                value: initialCode,
                language: initialLang,
                theme: 'vs-dark',
                automaticLayout: true,
                minimap: { enabled: false },
                fontSize: 14,
                fontFamily: '"JetBrains Mono", Consolas, monospace',
                scrollBeyondLastLine: false,
                roundedSelection: true
            });

            // AI Editor
            window.aiEditor = monaco.editor.create(document.getElementById('ai-editor-container'), {
                value: '// AI translation will appear here...',
                language: initialLang,
                theme: 'vs-dark',
                readOnly: true,
                automaticLayout: true,
                minimap: { enabled: false },
                fontSize: 14,
                fontFamily: '"JetBrains Mono", Consolas, monospace',
                scrollBeyondLastLine: false,
                roundedSelection: true
            });

            const problemIdSolve = parseInt(document.getElementById('monaco-editor-container').dataset.problemId, 10);
            let improveUnlockedThisSession = false;

            function setImproveSolutionEnabled(enabled) {
                const btn = document.getElementById('btnImproveSolution');
                if (!btn) return;
                btn.disabled = !enabled;
                btn.title = enabled
                    ? 'Compare your accepted solution with an optimal approach and get refactoring steps (read-only panel below).'
                    : 'Submit your code and wait until the judge reports Accepted on this page.';
            }

            setImproveSolutionEnabled(false);

            // SignalR Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/translationHub")
                .withServerTimeout(300000) // NEW: Wait up to 5 minutes (300,000 ms)
                .build();

            connection.on("ReceiveCodeChunk", function (chunk) {
                let currentCode = window.aiEditor.getValue();
                let newCode = currentCode + chunk;

                // Scrub out any markdown blocks
                newCode = newCode.replace(/```[a-zA-Z]*\n?/g, "").replace(/```/g, "");

                window.aiEditor.setValue(newCode);
                window.aiEditor.revealLine(window.aiEditor.getModel().getLineCount());
            });

            connection.start().catch(err => console.error("SignalR Error: ", err));

            let sourceLang = initialLang;
            const sourceSelect = document.getElementById('languageSelect');
            const targetSelect = document.getElementById('targetLanguageSelect');
            const btnTranspile = document.getElementById('btnTranspile');

            // --- NEW: Update dynamic button text ---
            function updateTranspileButtonText() {
                const srcText = sourceSelect.options[sourceSelect.selectedIndex].text;
                const tgtText = targetSelect.options[targetSelect.selectedIndex].text;
                btnTranspile.innerHTML = `<i class="bi bi-robot"></i> Convert from ${srcText} to ${tgtText}`;
            }

            // Set initial text on page load
            updateTranspileButtonText();

            // Handle Target Language Change
            targetSelect.addEventListener('change', updateTranspileButtonText);

            // Handle Source Language Change for User Editor
            sourceSelect.addEventListener('change', function(e) {
                sourceLang = e.target.value;
                const template = codeTemplates[sourceLang] || defaultCode;
                window.editor.setValue(template);
                monaco.editor.setModelLanguage(window.editor.getModel(), sourceLang);
                updateTranspileButtonText(); // Update the button text when source changes
            });

            // Handle Transpile Button
            btnTranspile.addEventListener('click', async function() {
                const targetLang = targetSelect.value; // <-- NOW PROPERLY READS FROM THE TARGET DROPDOWN
                const sourceCode = window.editor.getValue();
                const loadingBar = document.getElementById('aiLoadingIndicator');
                const aiContainer = document.getElementById('ai-editor-container');
                const userContainer = document.getElementById('monaco-editor-container');

                // Reveal AI editor and adjust widths
                aiContainer.style.display = 'block';
                userContainer.classList.remove('w-100');
                userContainer.classList.add('w-50');

                loadingBar.style.setProperty('display', 'flex', 'important');

                monaco.editor.setModelLanguage(window.aiEditor.getModel(), targetLang);
                window.aiEditor.setValue("");

                try {
                    await connection.invoke("TranslateCode", sourceCode, sourceLang, targetLang);
                } catch (err) {
                    console.error("Translation Error: ", err);
                    window.aiEditor.setValue("// Error translating code.");
                } finally {
                    loadingBar.style.setProperty('display', 'none', 'important');
                }
            });

           
             

            // Ask for Hint Button Logic
            document.getElementById('askHintBtn').addEventListener('click', async function() {
                const hintContainer = document.getElementById('hintContainer');
                const askHintBtn = document.getElementById('askHintBtn');
                const problemId = document.getElementById('monaco-editor-container').dataset.problemId;
                const sourceCode = window.editor ? window.editor.getValue() : '';
                const language = document.getElementById('languageSelect').value;

                askHintBtn.disabled = true;
                hintContainer.textContent = "Generating hint...";

                try {
                    const response = await fetch('/Home/GetHint', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            problemId: parseInt(problemId),
                            sourceCode: sourceCode,
                            language: language
                        })
                    });

                    if ((response.redirected && response.url.includes('Login')) || response.status === 401) {
                        window.location.href = '/Identity/Account/Login';
                        return;
                    }

                    if (!response.ok) throw new Error(await response.text());

                    const data = await response.json();
                    hintContainer.textContent = data.hint || "No hint was returned.";
                } catch (err) {
                    hintContainer.textContent = "Error requesting hint: " + err.message;
                } finally {
                    askHintBtn.disabled = false;
                }
            });

            // Handle Complete Code Button
            document.getElementById('btnCompleteCode').addEventListener('click', async function() {
                const btn = document.getElementById('btnCompleteCode');
                const consoleOutput = document.getElementById('consoleOutput');
                const problemId = document.getElementById('monaco-editor-container').dataset.problemId;
                const sourceCode = window.editor ? window.editor.getValue() : '';
                const language = document.getElementById('languageSelect').value;

                btn.disabled = true;
                consoleOutput.innerHTML = '<div class="p-2 text-info">Analyzing your approach and generating a full solution…</div>';

                try {
                    const response = await fetch('/Home/CompleteCurrentCode', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            problemId: parseInt(problemId),
                            sourceCode: sourceCode,
                            language: language
                        })
                    });

                    if ((response.redirected && response.url.includes('Login')) || response.status === 401) {
                        window.location.href = '/Identity/Account/Login';
                        return;
                    }

                    if (!response.ok) throw new Error(await response.text());

                    const data = await response.json();
                    if (window.editor && data.code) {
                        window.editor.setValue(data.code);
                        monaco.editor.setModelLanguage(window.editor.getModel(), language);
                    }

                    let msg = '<div class="p-2">';
                    if (data.approachSummary) {
                        msg += '<div class="mb-2"><strong>Detected approach</strong><pre class="small text-muted mb-0" style="white-space:pre-wrap;">' +
                            escapeHtml(data.approachSummary) + '</pre></div>';
                    }
                    if (data.testsPassed) {
                        msg += '<div class="text-success"><strong>Tests:</strong> all passed (local check).</div>';
                    } else {
                        msg += '<div class="text-warning"><strong>Tests:</strong> ' + (data.status || 'not all passed') + '. ';
                        msg += (data.message || 'Review the result or edit the code, then use Submit.') + '</div>';
                    }
                    msg += '</div>';
                    consoleOutput.innerHTML = msg;
                } catch (err) {
                    consoleOutput.innerHTML = '<div class="p-2 text-danger">Complete current code failed: ' + err.message + '</div>';
                } finally {
                    btn.disabled = false;
                }
            });

            // Handle Improve Solution Button
            document.getElementById('btnImproveSolution').addEventListener('click', async function() {
                const btn = document.getElementById('btnImproveSolution');
                if (btn.disabled) return;

                const panel = document.getElementById('improveSolutionPanel');
                const preCode = document.getElementById('improveCodeBlock');
                const preDs = document.getElementById('improveOptimalDs');
                const preSteps = document.getElementById('improveSteps');
                const sourceCode = window.editor ? window.editor.getValue() : '';
                const language = document.getElementById('languageSelect').value;

                btn.disabled = true;
                panel.classList.remove('d-none');
                preCode.textContent = 'Loading…';
                preDs.textContent = '';
                preSteps.textContent = '';

                try {
                    const response = await fetch('/Home/ImproveSolution', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            problemId: problemIdSolve,
                            sourceCode: sourceCode,
                            language: language
                        })
                    });

                    if ((response.redirected && response.url.includes('Login')) || response.status === 401) {
                        window.location.href = '/Identity/Account/Login';
                        return;
                    }

                    if (!response.ok) {
                        const errText = await response.text();
                        preCode.textContent = '';
                        preDs.textContent = '';
                        preSteps.textContent = errText || 'Request failed.';
                        return;
                    }

                    const data = await response.json();
                    preCode.textContent = data.codeBlockToModify || '(none)';
                    preDs.textContent = data.optimalDataStructure || '(none)';
                    preSteps.textContent = data.refactoringSteps || '(none)';
                } catch (err) {
                    preCode.textContent = '';
                    preDs.textContent = '';
                    preSteps.textContent = 'Error: ' + err.message;
                } finally {
                    if (improveUnlockedThisSession) setImproveSolutionEnabled(true);
                }
            });

            // Submit Button Logic
            document.getElementById('btnSubmit').addEventListener('click', async function() {
                const sourceCode = window.editor.getValue();
                const language = document.getElementById('languageSelect').value;
                const problemId = document.getElementById('monaco-editor-container').dataset.problemId;
                const consoleOutput = document.getElementById('consoleOutput');
                const btnSubmit = document.getElementById('btnSubmit');

                consoleOutput.innerHTML = "Submitting...";
                btnSubmit.disabled = true;
                improveUnlockedThisSession = false;
                setImproveSolutionEnabled(false);

                // Reset badges
                const tcBadge = document.getElementById('timeComplexity');
                const scBadge = document.getElementById('spaceComplexity');
                tcBadge.innerText = "⏱ O(?)";
                scBadge.innerText = "💾 O(?)";
                tcBadge.className = "jbo-badge-soft";
                scBadge.className = "jbo-badge-soft";

                try {
                    const response = await fetch('/api/submission', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ problemId: parseInt(problemId), sourceCode, language })
                    });

                    // If unauthorized, redirect to login
                    if (response.status === 401 || (response.redirected && response.url.includes('Login'))) {
                        window.location.href = '/Identity/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                        return;
                    }

                    if (!response.ok) throw new Error(await response.text());

                    const data = await response.json();
                    pollStatus(data.submissionId);
                } catch (err) {
                    consoleOutput.innerHTML = "Error: " + err.message;
                    btnSubmit.disabled = false;
                }
            });

            // Poll Status Logic
            async function pollStatus(id) {
                const consoleOutput = document.getElementById('consoleOutput');
                const btnSubmit = document.getElementById('btnSubmit');

                const interval = setInterval(async () => {
                    try {
                        const response = await fetch('/api/submission/' + id);

                        if ((response.redirected && response.url.includes('Login')) || response.status === 401) {
                            clearInterval(interval);
                            window.location.href = '/Identity/Account/Login';
                            return;
                        }

                        const data = await response.json();
                        consoleOutput.innerHTML = "Status: " + data.status + "...";

                        if (data.status !== 'Pending' && data.status !== 'Running' && data.status !== 'Compiling') {
                            clearInterval(interval);
                            displayResult(data);
                            btnSubmit.disabled = false;
                        }
                    } catch (err) {
                        clearInterval(interval);
                        consoleOutput.innerHTML = "Error polling: " + err.message;
                        btnSubmit.disabled = false;
                    }
                }, 2000);
            }

            // Display Results Logic
            async function displayResult(data) {
                const consoleOutput = document.getElementById('consoleOutput');
                let html = `<div class="p-2">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="${data.status === 'Accepted' ? 'text-success' : 'text-danger'} mb-0">Submission: ${data.status}</h4>
                    <div class="small text-muted">
                        ${data.userTimeMs ? `<span>⏱ ${data.userTimeMs.toFixed(0)}ms</span>` : ''}
                        ${data.peakMemoryKb ? `<span class="ms-2">💾 ${data.peakMemoryKb.toFixed(0)}KB</span>` : ''}
                    </div>
                </div>
                <hr class="my-2 border-secondary"/>`;

                if (data.errorMessage) {
                    html += `<div class="alert alert-danger mb-3" style="white-space: pre-wrap; font-family: monospace;">${escapeHtml(data.errorMessage)}</div>`;
                }

                if (data.results) {
                    const results = JSON.parse(data.results);
                    if (results && results.length > 0) {
                        results.forEach((r, idx) => {
                            const isOk = r.status === 'Accepted';
                            html += `
                            <div class="mb-4 p-2 border ${isOk ? 'border-success' : 'border-danger'} rounded bg-dark">
                                <div class="d-flex justify-content-between">
                                    <strong>Test Case #${idx + 1}</strong>
                                    <span class="badge ${isOk ? 'bg-success' : 'bg-danger'}">${r.status}</span>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Input:</small>
                                    <pre class="m-0 p-1 bg-black text-info small">${r.input || 'N/A'}</pre>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Expected:</small>
                                    <pre class="m-0 p-1 bg-black text-success small">${r.expected || 'N/A'}</pre>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted">Actual Output (stdout):</small>
                                    <pre class="m-0 p-1 bg-black text-light small">${r.output || 'N/A'}</pre>
                                </div>
                                ${r.error ? `
                                <div class="mt-2">
                                    <small class="text-muted">Error (stderr):</small>
                                    <pre class="m-0 p-1 bg-black text-danger small">${r.error}</pre>
                                </div>` : ''}
                            </div>`;
                        });
                    }
                }

                html += `</div>`;
                consoleOutput.innerHTML = html;

                if (data.status === 'Accepted') {
                    improveUnlockedThisSession = true;
                    setImproveSolutionEnabled(true);
                } else {
                    improveUnlockedThisSession = false;
                    setImproveSolutionEnabled(false);
                }

                // AI Complexity Analysis
                if (data.status === 'Accepted') {
                    const tcBadge = document.getElementById('timeComplexity');
                    const scBadge = document.getElementById('spaceComplexity');

                    tcBadge.innerText = "⏱ Analyzing...";
                    scBadge.innerText = "💾 Analyzing...";
                    tcBadge.classList.add('text-warning');
                    scBadge.classList.add('text-warning');

                    try {
                        const sourceCode = window.editor.getValue();
                        const problemId = document.getElementById('monaco-editor-container').dataset.problemId;
                        const aiResponse = await fetch('/Home/AnalyzeComplexity', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                problemId: parseInt(problemId),
                                sourceCode: sourceCode,
                                language: document.getElementById('languageSelect').value
                            })
                        });

                        if (aiResponse.ok) {
                            const aiData = await aiResponse.json();
                            tcBadge.innerText = `⏱ ${aiData.timeComplexity}`;
                            scBadge.innerText = `💾 ${aiData.spaceComplexity}`;

                            tcBadge.classList.remove('text-warning');
                            scBadge.classList.remove('text-warning');
                            tcBadge.classList.add('text-success', 'fw-bold');
                            scBadge.classList.add('text-success', 'fw-bold');
                        }
                    } catch (e) {
                        console.error("Eroare la Agentul AI:", e);
                        tcBadge.innerText = "⏱ O(?)";
                        scBadge.innerText = "💾 O(?)";
                    }
                }
            }
        });
    </script>
}
