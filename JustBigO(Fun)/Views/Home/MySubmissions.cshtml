@* MDSP/JustBigO-Fun---Software-Development-Methodologies/JustBigO(Fun)/Views/Home/MySubmissions.cshtml *@
@model IEnumerable<JustBigO_Fun_.Models.Submission>
@{
    ViewData["Title"] = "Submission History";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history"></i> Submission History @if (ViewData["Subtitle"] != null) {
            <small class="text-muted">@ViewData["Subtitle"]</small>
        }
    </h2>
    <a href="/Home/Index" class="btn btn-outline-primary">Back to Problems</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center p-5 shadow-sm rounded">
        <h4>No submissions found!</h4>
        <p class="mb-0">Pick a problem and start coding to see your history here.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Date</th>
                            <th>Problem</th>
                            <th>Status</th>
                            <th>Language</th>
                            <th>Execution Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@sub.Id</td>
                                <td>@sub.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    @if (sub.Problem != null)
                                    {
                                        <a href="/Home/Solve/@sub.ProblemId" class="text-decoration-none fw-semibold">
                                            @sub.Problem.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Problem Deleted</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var badgeClass = sub.Status switch
                                        {
                                            JustBigO_Fun_.Models.SubmissionStatus.Accepted => "bg-success",
                                            JustBigO_Fun_.Models.SubmissionStatus.WrongAnswer => "bg-danger",
                                            JustBigO_Fun_.Models.SubmissionStatus.CompilationError => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 py-2 rounded-pill fs-6" style="min-width: 120px;">
                                        @sub.Status
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@sub.Language</span></td>
                                <td>@(sub.ExecutionTimeMs?.ToString("F2") ?? "-") ms</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="viewCode(@sub.Id)">View Code</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
</div>