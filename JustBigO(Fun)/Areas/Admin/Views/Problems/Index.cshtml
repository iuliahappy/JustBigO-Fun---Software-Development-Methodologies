@model IEnumerable<ProblemListVm>
@{
    ViewData["Title"] = "Manage problems";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">Manage problems</h1>
        <a asp-action="Create" class="btn jbo-btn-primary">+ New problem</a>
    </div>

    <div class="jbo-section-card">
        <table class="jbo-mini-table">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Difficulty</th>
                    <th>Tests</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model ?? Enumerable.Empty<ProblemListVm>())
                {
                    <tr>
                        <td>@p.OrderIndex</td>
                        <td>@p.Title</td>
                        <td><code>@p.Slug</code></td>
                        <td>@p.Difficulty</td>
                        <td>@p.TestCount</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm jbo-btn-ghost">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this problem?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="mt-3">
        <a asp-controller="Home" asp-action="Index" asp-area="" class="jbo-problem-link">← Back to Dashboard</a>
    </p>
</div>
